# Runtime URL: use Neon’s pooled hostname, which includes -pooler.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migration/admin URL: use Neon’s direct hostname without -pooler.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
TRACKER_HOST=0.0.0.0
TRACKER_PORT=8881
FRAME_MAX_BYTES=4096
FRAME_BUFFER_MAX_BYTES=8192
IDLE_TIMEOUT_SECONDS=180
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=8
AUTH_ATTEMPTS_PER_MINUTE=20
# Generate both values with a password manager or a local secrets tool.
DEVICE_SECRET_KEY_B64=replace-with-32-byte-url-safe-base64
DEVICE_AUTH_PEPPER_B64=replace-with-random-url-safe-base64
