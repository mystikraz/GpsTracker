# Runtime URL: use Neon’s pooled hostname, which includes -pooler.
FLEET_API_DATABASE_URL=postgresql://fleet_api:REPLACE@REPLACE-pooler.REPLACE/neondb?sslmode=require&channel_binding=require
FLEET_INGEST_DATABASE_URL=postgresql://fleet_ingest:REPLACE@REPLACE-pooler.REPLACE/neondb?sslmode=require&channel_binding=require
FLEET_WORKER_DATABASE_URL=postgresql://fleet_worker:REPLACE@REPLACE-pooler.REPLACE/neondb?sslmode=require&channel_binding=require
# Migration/admin URL: use Neon’s direct hostname without -pooler.
DIRECT_DATABASE_URL=postgresql://migration_owner:REPLACE@REPLACE.REPLACE/neondb?sslmode=require&channel_binding=require
# Integration tests require an isolated disposable/test-branch URL, never production.
# TEST_DATABASE_URL=postgresql://user:password@test-branch.example.neon.tech/neondb?sslmode=require
# TEST_API_DATABASE_URL=postgresql://fleet_api:password@127.0.0.1:5432/fleet_tracker_test
# TEST_INGEST_DATABASE_URL=postgresql://fleet_ingest:password@127.0.0.1:5432/fleet_tracker_test
# TEST_WORKER_DATABASE_URL=postgresql://fleet_worker:password@127.0.0.1:5432/fleet_tracker_test
TRACKER_HOST=0.0.0.0
TRACKER_PORT=8881
FRAME_MAX_BYTES=4096
FRAME_BUFFER_MAX_BYTES=8192
IDLE_TIMEOUT_SECONDS=180
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=8
AUTH_ATTEMPTS_PER_MINUTE=20
AUTHENTICATED_CONNECTION_IDLE_SECONDS=60
# Opt in to sampling ordinary live GPS frames; 0 stores every frame.
POSITION_MIN_INTERVAL_SECONDS=0
# Generate both values with a password manager or a local secrets tool.
DEVICE_SECRET_KEY_B64=replace-with-32-byte-url-safe-base64
DEVICE_AUTH_PEPPER_B64=replace-with-random-url-safe-base64
PASSWORD_BREACHED_LIST_PATH=config/common-passwords.txt
PASSWORD_HASH_MAX_CONCURRENCY=2
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
OWNER_ADMIN_SESSION_IDLE_SECONDS=900
OWNER_ADMIN_SESSION_ABSOLUTE_SECONDS=28800
REAUTH_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOCKOUT_SECONDS=900
EMAIL_PROVIDER=manual-link
PUBLIC_BASE_URL=https://fleet.example.invalid
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=80
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
SSE_MAX_STREAMS=16
VEHICLE_OFFLINE_AFTER_SECONDS=300
VEHICLE_MOVING_SPEED_KMH=1
